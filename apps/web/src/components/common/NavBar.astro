---
const ROUTES = [
  { path: "/", name: "Inicio" },
  { path: "/sobre-nosotros", name: "Acerca de" },
  { path: "/habitaciones", name: "Habitaciones" },
  { path: "/servicios", name: "Servicios" },
  { path: "/galeria", name: "Galería" },
  { path: "/contacto", name: "Contacto" },
]

const currentPath = Astro.url.pathname
const isActive = (path: string) =>
  path === "/" ? currentPath === "/" : currentPath.startsWith(path)

const isHome = currentPath === "/"   // ← detecta si es el home

import { Image } from "astro:assets"
import LogoHH from "../../assets/images/HHLogo.png"
---

<header
  class={`navbar ${isHome ? "navbar--home" : "navbar--solid"}`}
  id="navbar"
>
  <div class="navbar__container">
    <a href="/" class="navbar__logo">
      <Image src={LogoHH} alt="Logo Hotel Horiani" />
    </a>

    <nav class="navbar__nav" aria-label="Navegación principal">
      {ROUTES.map(route => (
        <a
          href={route.path}
          class={`navbar__link ${isActive(route.path) ? "navbar__link--active" : ""}`}
          aria-current={isActive(route.path) ? "page" : undefined}
        >
          {route.name}
        </a>
      ))}
    </nav>

    <div class="navbar__actions">
      <a href="/reservar" class="navbar__cta">Reservar ahora</a>
      <button
        class="navbar__hamburger"
        id="hamburger"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div class="navbar__mobile" id="mobile-menu" aria-hidden="true">
    <nav aria-label="Menú móvil">
      {ROUTES.map(route => (
        <a
          href={route.path}
          class={`navbar__mobile-link ${isActive(route.path) ? "navbar__mobile-link--active" : ""}`}
          aria-current={isActive(route.path) ? "page" : undefined}
        >
          {route.name}
        </a>
      ))}
      <a href="/reservar" class="navbar__mobile-cta">Reservar ahora</a>
    </nav>
  </div>
</header>

<style>
  :root {
    --navy:      #1B3A6B;
    --navy-dark: #122850;
    --gold:      #C9A84C;
    --gold-dark: #B8962F;
    --white:     #FFFFFF;
    --nav-h:     72px;
  }

  /* ── Base ── */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--nav-h);
    transition: background 0.4s ease,
                backdrop-filter 0.4s ease,
                box-shadow 0.4s ease;
  }

  /* HOME — transparente al inicio */
  .navbar--home {
background: transparent; 
  }

  /* OTRAS PÁGINAS — navy sólido siempre */
  .navbar--solid {
    background: var(--navy);
    box-shadow: 0 1px 0 rgba(255,255,255,0.06),
                0 4px 20px rgba(0,0,0,0.15);
  }

  /* SCROLL — aplica solo en home */
.navbar--home.scrolled {
  background: rgba(18, 40, 80, 0.88);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-shadow: 0 1px 0 rgba(255,255,255,0.08),
              0 4px 24px rgba(0,0,0,0.20);
}

  /* ── Contenedor ── */
  .navbar__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  /* ── Logo ── */
  .navbar__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

.navbar__logo img {
  height: 48px;
  width: auto;
  object-fit: contain;
  filter: brightness(0) invert(1);              /* logo siempre blanco */
  drop-shadow: drop-shadow(0 1px 4px rgba(0,0,0,0.5));
}

  /* ── Nav links — siempre blancos ── */
  .navbar__nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex: 1;
    justify-content: center;
  }

.navbar__link {
  color: rgba(255, 255, 255, 0.92);
  text-decoration: none;
  font-size: 0.9rem;
  font-weight: 400;
  padding: 0.5rem 0.875rem;
  border-radius: 6px;
  position: relative;
  transition: color 0.2s ease;
  letter-spacing: 0.01em;
  text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);   /* ← legible sobre cualquier foto */
}

  .navbar__link::after {
    content: "";
    position: absolute;
    bottom: 2px;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    width: calc(100% - 1.75rem);
    height: 1.5px;
    background: var(--gold);
    transition: transform 0.25s ease;
    border-radius: 2px;
  }

  .navbar__link:hover {
    color: var(--white);
  }

  .navbar__link:hover::after {
    transform: translateX(-50%) scaleX(0.6);
  }

  .navbar__link--active {
    color: var(--white);
    font-weight: 500;
  }

  .navbar__link--active::after {
    transform: translateX(-50%) scaleX(1) !important;
  }

  /* ── CTA ── */
  .navbar__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .navbar__cta {
    background: var(--gold);
    color: var(--navy);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.5rem 1.25rem;
    border-radius: 6px;
    letter-spacing: 0.02em;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .navbar__cta:hover {
    background: var(--gold-dark);
    transform: translateY(-1px);
  }

  .navbar__cta:active {
    transform: translateY(0);
  }

  /* ── Hamburguesa ── */
  .navbar__hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
  }

  .navbar__hamburger span {
    display: block;
    height: 2px;
    background: var(--white);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .navbar__hamburger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .navbar__hamburger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .navbar__hamburger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ── Menú móvil ── */
  .navbar__mobile {
    background: rgba(18, 40, 80, 0.97);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease;
  }

  .navbar__mobile[aria-hidden="false"] {
    max-height: 500px;
  }

  .navbar__mobile nav {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 1.5rem 1.5rem;
    gap: 0;
  }

  .navbar__mobile-link {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 400;
    padding: 0.875rem 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    transition: color 0.2s, padding-left 0.2s;
  }

  .navbar__mobile-link:hover {
    color: var(--white);
    padding-left: 0.75rem;
  }

  .navbar__mobile-link--active {
    color: var(--gold);
    font-weight: 500;
  }

  .navbar__mobile-cta {
    display: block;
    margin-top: 1.25rem;
    background: var(--gold);
    color: var(--navy);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 600;
    padding: 0.875rem 1.25rem;
    border-radius: 6px;
    text-align: center;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .navbar__nav       { display: none; }
    .navbar__cta       { display: none; }
    .navbar__hamburger { display: flex; }

    .navbar__logo img  { height: 38px; }
    .navbar__container { padding: 0 1rem; }
  }

  @media (max-width: 380px) {
    .navbar__logo img { height: 32px; }
  }
</style>

<script>
  const navbar = document.getElementById("navbar")!
  const hamburger = document.getElementById("hamburger")!
  const mobileMenu = document.getElementById("mobile-menu")!

  // Solo aplica el scroll effect si es el home
  if (navbar.classList.contains("navbar--home")) {
    const onScroll = () => {
      navbar.classList.toggle("scrolled", window.scrollY > 20)
    }
    window.addEventListener("scroll", onScroll, { passive: true })
    onScroll()
  }

  hamburger.addEventListener("click", () => {
    const isOpen = hamburger.getAttribute("aria-expanded") === "true"
    hamburger.setAttribute("aria-expanded", String(!isOpen))
    mobileMenu.setAttribute("aria-hidden", String(isOpen))
    hamburger.setAttribute("aria-label", isOpen ? "Abrir menú" : "Cerrar menú")
  })

  mobileMenu.querySelectorAll("a").forEach(link => {
    link.addEventListener("click", () => {
      hamburger.setAttribute("aria-expanded", "false")
      mobileMenu.setAttribute("aria-hidden", "true")
      hamburger.setAttribute("aria-label", "Abrir menú")
    })
  })
</script>