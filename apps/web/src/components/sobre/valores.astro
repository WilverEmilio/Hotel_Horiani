---
import valores from "../../data/valores.json"
---

<section class="valores">
  <div class="valores__container">

    <div class="valores__header">
      <span class="valores__eyebrow">Nuestros principios</span>
      <h2 class="valores__titulo">Valores</h2>
      <div class="valores__divider"></div>
    </div>

    <div class="valores__grid">
      {valores.map(valor => (
        <div class="valores__card">
          <div class="valores__icono-wrap">
            <i class={`ti ${valor.icono}`} aria-hidden="true"></i>
          </div>
          <h3 class="valores__nombre">{valor.titulo}</h3>
          <p class="valores__desc">{valor.descripcion}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .valores {
    background: #f8f7f4;
    padding: 5rem 1.5rem;
  }

  .valores__container {
    max-width: 1100px;
    margin: 0 auto;
  }

  /* ── Header ── */
  .valores__header {
    text-align: left;
    margin-bottom: 3.5rem;
  }

  .valores__eyebrow {
    display: inline-block;
    color: #C9A84C;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .valores__titulo {
    color: #1B3A6B;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    font-family: Georgia, serif;
    margin-bottom: 1rem;
  }

  .valores__divider {
    width: 100px;
    height: 3px;
    background: #C9A84C;
    border-radius: 2px;
    margin: 0 auto 0 0;

  }

  /* ── Grid ── */
  .valores__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  /* ── Card ── */
  .valores__card {
    background: #ffffff;
    border-radius: 12px;
    border: 0.5px solid #eeeeee;
    border-top: 3px solid #C9A84C;   /* borde dorado arriba */
    padding: 2rem 1.5rem;
    text-align: center;
    transition: transform 0.3s ease,
                box-shadow 0.3s ease;
  }

  .valores__card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 32px rgba(27, 58, 107, 0.10);
  }

  /* ── Ícono ── */
  .valores__icono-wrap {
    width: 100px;
    height: 100px;
    border-radius: 80%;
    background: #dde8fb;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem;
    transition: background 0.3s;
  }

  .valores__card:hover .valores__icono-wrap {
    background: #1B3A6B;
  }

  .valores__icono-wrap i {
    font-size: 1.5rem;
    color: #1B3A6B;
    transition: color 0.3s;
  }

  .valores__card:hover .valores__icono-wrap i {
    color: #f9f8f6;
  }

  /* ── Texto ── */
  .valores__nombre {
    color: #1B3A6B;
    font-size: 1.1rem;
    font-weight: 700;
    font-family: Georgia, serif;
    margin-bottom: 0.75rem;
  }

  .valores__desc {
    color: #666666;
    font-size: 0.9rem;
    line-height: 1.7;
    margin: 0;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .valores__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .valores {
      padding: 4rem 1.25rem;
    }

    .valores__grid {
      grid-template-columns: 1fr;
    }

    .valores__card {
      padding: 1.75rem 1.25rem;
    }
  }
</style>