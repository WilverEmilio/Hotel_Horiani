---
import HeroCarousel from "./HeroCarousel"

const slides = [
  {
    image: "/images/hero/ParqueoCA.jpeg",
    eyebrow: "Bienvenido a",
    title: "Hotel Horiani",
    subtitle: "Descansa, disfruta y vive una experiencia única.\nTu comodidad es nuestra prioridad.",
  },
  {
    image: "/images/hero/Flores.jpeg",
    eyebrow: "Nuestras instalaciones",
    title: "Confort y Elegancia",
    subtitle: "Habitaciones diseñadas para tu descanso absoluto,\ncon todas las comodidades que mereces.",
  },
  {
    image: "/images/hero/Pasillo1.jpeg",
    eyebrow: "Vive la experiencia",
    title: "Un Lugar Único",
    subtitle: "En el corazón de la ciudad, a minutos de\nlos principales atractivos turísticos.",
  },
]
---

<section class="hero">
  <HeroCarousel
    client:only="react"
    slides={slides}
    interval={6000}
  />
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 72px);
    overflow: hidden;
    background: #1B3A6B;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 100svh;
      display: flex;
      align-items: flex-end;
    }
  }
</style>