---
import SplitText from "./TextHome"
import HeroCarousel from "./HeroCarousel"

const heroImages = [
  "/images/hero/ParqueoHotel.jpg",
  "/images/hero/unnamed.jpg",
  "/images/hero/prueba.jpeg"
]
---

<section class="hero">
  <HeroCarousel 
    client:load
    images={heroImages} 
  />

  <div class="hero__content">
    <span class="hero__eyebrow">
      <SplitText
        client:load
        text="Bienvenido a"
        className="text-2xl font-semibold text-center"
        delay={50}
        duration={1.25}
        ease="power3.out"
        splitType="chars"
        from={{ opacity: 0, y: 40 }}
        to={{ opacity: 1, y: 0 }}
        threshold={0.1}
        rootMargin="-100px"
        textAlign="center"
      />
    </span>
    <h1 class="hero__title">
      <SplitText
        client:load
        text="Hotel Horiani"
        className="text-2xl font-semibold text-center"
        delay={50}
        duration={1.25}
        ease="power3.out"
        splitType="chars"
        from={{ opacity: 0, y: 40 }}
        to={{ opacity: 1, y: 0 }}
        threshold={0.1}
        rootMargin="-100px"
        textAlign="center"

      />
    </h1>
    <p class="hero__subtitle">
      Descansa, disfruta y vive una experiencia única.<br />
      Tu comodidad es nuestra prioridad.
    </p>
    <div class="hero__actions">
      <a href="/reservar" class="hero__btn hero__btn--primary">Reservar ahora</a>
      <a href="/habitaciones" class="hero__btn hero__btn--secondary">Ver habitaciones</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 72px);
    background: linear-gradient(135deg, #1B3A6B 0%, #122850 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem 1.5rem;
    background-size: #1B3A6B;
  }

  .hero__content {
    position: relative;
    max-width: 700px;
    z-index: 2;
  }

  .hero__eyebrow {
    color: #C9A84C;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .hero__title {
    color: #ffffff;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    font-family: Georgia, serif;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .hero__subtitle {
    color: rgba(255, 255, 255, 0.75);
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero__btn {
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 600;
    padding: 0.75rem 1.75rem;
    border-radius: 6px;
    transition: transform 0.2s, background 0.2s;
  }

  .hero__btn:hover {
    transform: translateY(-2px);
  }

  .hero__btn--primary {
    background: #C9A84C;
    color: #1B3A6B;
  }

  .hero__btn--primary:hover {
    background: #B8962F;
  }

  .hero__btn--secondary {
    background: transparent;
    color: #ffffff;
    border: 1.5px solid rgba(255, 255, 255, 0.5);
  }

  .hero__btn--secondary:hover {
    border-color: #ffffff;
  }
  /* ── Móvil ── */
@media (max-width: 768px) {
  .hero {
    min-height: 100svh;        /* svh = altura real del teléfono sin la barra del browser */
    padding: 1.25rem 1rem;
    align-items: flex-end;     /* contenido más abajo, se ve mejor con foto de fondo */
    padding-bottom: 5rem;
  }

  .hero__content {
    max-width: 100%;
  }

  .hero__eyebrow {
    font-size: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .hero__title {
    font-size: clamp(2rem, 10vw, 2.75rem);
    margin-bottom: 1rem;
  }

  .hero__subtitle {
    font-size: 0.95rem;
    margin-bottom: 2rem;
  }

  .hero__actions {
    flex-direction: column;    /* botones uno debajo del otro */
    align-items: stretch;      /* ocupan todo el ancho */
    gap: 0.75rem;
  }

  .hero__btn {
    text-align: center;
    padding: 0.875rem 1.25rem; /* más alto para ser fácil de tocar */
    font-size: 1rem;
  }
}

/* ── Pantallas muy pequeñas ── */
@media (max-width: 380px) {
  .hero__title {
    font-size: 1.75rem;
  }
}
</style>